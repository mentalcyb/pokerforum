{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/lib/poker",
    "outDir": ".test-build",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/poker/cards.ts",
